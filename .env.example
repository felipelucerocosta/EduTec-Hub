# Configuración de EduTechHub - Variables de Entorno

# Puerto del Servidor Backend (Express)
PORT=3001

# Secreto de Sesión (generar clave segura para producción)
SESSION_SECRET=desarrollo-edutech-secreto-cambiar-en-produccion

# URL del Frontend para CORS y enlaces
FRONTEND_URL=http://localhost:5173

# API Key para Asistente Alfred (Google Gemini IA)
GEMINI_API_KEY=

# Configuración de Correo SMTP (opcional para notificaciones/recuperación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@institucion.edu.ar
SMTP_PASS=tu-password-o-app-key
SMTP_FROM=EduTech Hub <no-reply@edutechhub.edu.ar>

# Administrador por Defecto (opcional)
ADMIN_EMAIL=admin@edutechhub.edu.ar
ADMIN_PASSWORD=Admin123456!

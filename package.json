{
  "name": "edutechhub",
  "productName": "EduTechHub",
  "version": "1.0.0",
  "description": "Plataforma de Gestión Educativa para Escuelas Técnicas",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "cd backend && ts-node-dev --respawn --transpile-only server.ts",
    "build": "tsc -p tsconfig.app.json && vite build",
    "build:backend": "tsc -p tsconfig.backend.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "clean:db": "node backend/clean_database.js",
    "clean:db:force": "node backend/clean_database.js --yes",
    "build:exe": "npm run build && npm run build:backend && npx electron-builder --win --x64"
  },
  "build": {
    "appId": "com.edutechhub.app",
    "productName": "EduTechHub",
    "copyright": "EduTechHub Team",
    "directories": {
      "output": "release",
      "buildResources": "electron/assets"
    },
    "files": [
      "electron/main.js",
      "dist/**/*",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist_backend",
        "to": "app/backend",
        "filter": [
          "**/*.js"
        ]
      },
      {
        "from": "backend/node_modules",
        "to": "app/backend/node_modules"
      },
      {
        "from": "database",
        "to": "app/database"
      },
      {
        "from": "uploads",
        "to": "app/uploads"
      },
      {
        "from": "backend/.env",
        "to": "app/backend/.env"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EduTechHub"
    },
    "portable": {
      "artifactName": "EduTechHub-Portable.exe"
    }
  },
  "dependencies": {
    "boxicons": "^2.1.4",
    "express-session": "^1.19.0",
    "pg": "^8.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.16.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/express-session": "^1.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.1.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
